+def test_achievements_response_identifies_any_selected_profile(
+    plugin_api, tmp_path, monkeypatch, profile, display_name
+):
+    """The unlocked total must say which profile's history produced it.
+
+    Profile histories are intentionally separate. The dashboard response must
+    expose a display-safe source label so a user does not mistake a named
+    profile's achievement total for the default profile's total.
+    """
+    profile_home = tmp_path / "profiles" / profile
+    monkeypatch.setattr(plugin_api, "get_hermes_home", lambda: profile_home)
+    plugin_api.evaluate_all = lambda: {
+        "achievements": [],
+        "unlocked_count": 21,
+        "discovered_count": 39,
+        "secret_count": 0,
+        "total_count": 60,
+        "error": None,
+        "generated_at": 1,
+        # A cloned profile can inherit a snapshot from its source. The API must
+        # bind attribution to the current selected profile instead.
+        "profile_scope": {"profile": "source-profile"},
+    }
+
+    payload = asyncio.run(plugin_api.achievements())
+
+    assert payload["profile_scope"] == {
+        "profile": profile,
+        "label": f"{display_name} profile",
+        "detail": (
+            f"Showing achievements earned from the {display_name} profile's session "
+            "history. Profiles are scanned separately."
