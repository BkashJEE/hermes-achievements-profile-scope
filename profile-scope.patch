+def profile_scope() -> Dict[str, str]:
+    """Describe the profile whose session store an achievement scan uses.
+
+    The dashboard intentionally scans the Hermes home selected for this
+    process/request. Named profiles live under ``<root>/profiles/<name>``;
+    every other home is the default profile. Return only a display-safe
+    profile identifier, never a local filesystem path.
+    """
+    home = get_hermes_home()
+    profile = home.name if home.parent.name == "profiles" else "default"
+    display_name = profile.replace("-", " ").replace("_", " ").title()
+    return {
+        "profile": profile,
+        "label": f"{display_name} profile",
+        "detail": (
+            f"Showing achievements earned from the {display_name} profile's "
+            "session history. Profiles are scanned separately."
+        ),
+    }
+
+
